{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true
  }
}
