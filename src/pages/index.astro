---
import Concept from '../layouts/Concept.astro';
import RelationshipAtlas from '../components/concepts/RelationshipAtlas';
import source from '../content/Skills.md?raw';
import { buildCatalog } from '../lib/catalog';
import { buildCareers } from '../lib/careers';
const skills = buildCatalog(source);
const careers = buildCareers(source, skills);
---
<Concept title="Skills & careers atlas"><RelationshipAtlas skills={skills} careers={careers} base={import.meta.env.BASE_URL} client:load /></Concept>