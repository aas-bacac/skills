---
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/600.css';
import '@fontsource/dm-sans/700.css';
import '@fontsource/newsreader/400.css';
import '@fontsource/newsreader/500.css';
import '../styles/global.css';
import Explorer from '../components/Explorer';
import DevelopmentNotice from '../components/DevelopmentNotice.astro';
import source from '../content/Skills.md?raw';
import home from '../content/Home.md?raw';
import { buildCatalog, renderMarkdown } from '../lib/catalog';
const skills = buildCatalog(source);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A field guide to skills astronomers bring to careers beyond academia. Explore general, data science, and aerospace skills." />
    <meta name="theme-color" content="#236e59" />
    <title>Skills (Under development) | Beyond Astronomy</title>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
  </head>
  <body>
    <DevelopmentNotice />
    <a class="skip-link" href="#browse">Skip to skills</a>
    <Explorer skills={skills} originalHtml={renderMarkdown(source)} homeHtml={renderMarkdown(home)} base={import.meta.env.BASE_URL} client:load />
    <noscript>
      <style is:inline>.app-shell { display: none; }</style>
      <main class="no-script prose">
        <h1>Skills beyond astronomy</h1>
        <p>Source: <a href="https://github.com/aas-bacac/skills/wiki">AAS-BACAC skills wiki</a>.</p>
        <Fragment set:html={renderMarkdown(source)} />
      </main>
    </noscript>
  </body>
</html>