---
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/600.css';
import '@fontsource/dm-sans/700.css';
import '@fontsource/newsreader/400.css';
import { ArrowUpRight } from 'lucide-react';
import DevelopmentNotice from '../components/DevelopmentNotice.astro';
import '../styles/concepts.css';
const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Explore connections between astronomy experience, transferable skills, and careers with the BACAC skills atlas." />
    <title>{title} (Under development) | BACAC Skills</title>
    <link rel="icon" href={`${base}favicon.svg`} />
  </head>
  <body class="concept concept-relationships">
    <DevelopmentNotice />
    <a class="c-skip" href="#concept-main">Skip to content</a>
    <header class="c-masthead">
      <a class="c-brand" href={base}>BACAC</a>
      <div class="c-masthead-right"><a href="https://github.com/aas-bacac/skills/wiki/Skills">Read the skills guide <ArrowUpRight size={13} aria-hidden="true" /></a></div>
    </header>
    <main id="concept-main"><slot /><noscript><style is:inline>astro-island { display: none; }</style><p class="c-no-script">The interactive atlas requires JavaScript. <a href={`${base}guide/`}>Read the complete source guide</a>.</p></noscript></main>
    <footer class="c-footer"><span>Content: <a href="https://github.com/aas-bacac/skills/wiki/Skills">AAS-BACAC skills wiki</a></span><span>Career connections are editorial suggestions, not requirements.</span></footer>
  </body>
</html>