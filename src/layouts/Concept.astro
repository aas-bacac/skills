---
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/600.css';
import '@fontsource/dm-sans/700.css';
import '@fontsource/newsreader/400.css';
import { ArrowUpRight } from 'lucide-react';
import DevelopmentNotice from '../components/DevelopmentNotice.astro';
import '../styles/concepts.css';
const { title, number, variant = 'explorer' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A BACAC astronomy-to-industry career exploration design prototype, using the original skills wiki." />
    <title>{title} (Under development) | BACAC Skills</title>
    <link rel="icon" href={`${base}favicon.svg`} />
  </head>
  <body class={`concept concept-${variant}`}>
    <DevelopmentNotice />
    <a class="c-skip" href="#concept-main">Skip to content</a>
    <header class="c-masthead">
      <a class="c-brand" href={`${base}concepts/`}><span class="c-brand-initial">AAS</span><span>BACAC <strong>Skills</strong></span></a>
      <div class="c-masthead-right"><span class="c-version">{number ? `DESIGN ${number} / ${title}` : 'DESIGN EXPLORATION'}</span><a href={`${base}concepts/`}>Compare alternatives <ArrowUpRight size={13} aria-hidden="true" /></a></div>
    </header>
    <main id="concept-main"><slot />{number && <noscript><style is:inline>astro-island { display: none; }</style><p class="c-no-script">The interactive prototypes require JavaScript. <a href={`${base}guide/`}>Read the complete source guide</a>.</p></noscript>}</main>
    <footer class="c-footer"><span>Content: <a href="https://github.com/aas-bacac/skills/wiki/Skills">AAS-BACAC skills wiki</a></span><span>Prototype. Career connections are editorial suggestions, not requirements.</span><a href={`${base}guide/`}>Earlier field guide</a></footer>
  </body>
</html>